// widgetConfigId is the constant state id of this singleton resource: the
// widget configuration is a single account-wide setting, so there is no
// cloud-side identifier to model.
const widgetConfigId = "demo-widget-config"

// errWidgetConfigNotFound marks a read response that carries no
// configuration object. It is reported separately from transport and API
// failures so the caller can describe the situation precisely.
var errWidgetConfigNotFound = errors.New("DescribeWidgetConfig returned no configuration")

// NewDemoWidgetConfigResource is the factory referenced by
// tencentcloud/framework/registry.go to register this resource.
func NewDemoWidgetConfigResource() resource.Resource {
	return &DemoWidgetConfigResource{}
}

// DemoWidgetConfigResource implements resource.Resource for
// tencentcloud_demo_widget_config.
type DemoWidgetConfigResource struct {
	fw.ResourceWithConfigure
	fw.WithImportByID
}

