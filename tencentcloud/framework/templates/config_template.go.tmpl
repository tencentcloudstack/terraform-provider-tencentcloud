type DemoWidgetConfigResourceModel struct {
	Id         types.String `tfsdk:"id"`
	Settings   types.Object `tfsdk:"settings"`
	UpdateTime types.String `tfsdk:"update_time"`
	Modifier   types.String `tfsdk:"modifier"`
}

// widgetSettingsAttrTypes returns the attribute types of the settings
// object. It is shared by every conversion so the schema-facing shape never
