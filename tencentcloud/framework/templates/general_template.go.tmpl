// refreshDemoWidgetModel copies cloud-owned fields into the model. A
// cloud-omitted field keeps the previous value (fwHelper.StringValueOrPrev),
// otherwise Terraform fails the post-apply consistency check with
// "was <value>, but now null".
func refreshDemoWidgetModel(ctx context.Context, m *DemoWidgetResourceModel, item *demov20230101.Widget) diag.Diagnostics {
	if item == nil {
		return nil
	}

	m.Name = fwHelper.StringValueOrPrev(item.Name, m.Name)
	m.ZoneId = fwHelper.StringValueOrPrev(item.ZoneId, m.ZoneId)
	m.Remark = fwHelper.StringValueOrPrev(item.Remark, m.Remark)
	m.Status = fwHelper.StringValueOrPrev(item.Status, m.Status)
	m.CreateOn = fwHelper.StringValueOrPrev(item.CreateOn, m.CreateOn)
	return nil
}

// normalizeDemoWidgetComputedUnknowns rewrites unknown computed attributes to
// null so the model can be persisted into state before the read-back fills
// them with the cloud-side values.
func normalizeDemoWidgetComputedUnknowns(m *DemoWidgetResourceModel) {
	if m.Status.IsUnknown() {
		m.Status = types.StringNull()
	}

	if m.CreateOn.IsUnknown() {
		m.CreateOn = types.StringNull()
	}
}

// findDemoWidget picks this resource's own item from a describe list —
// the demo for the LIST-QUERY shape. When the describe API supports EXACT
// lookup (single item returned directly), DROP this helper and use the
// item straight away (conventions.md section 3).
func findDemoWidget(widgets []*demov20230101.Widget, widgetId string) *demov20230101.Widget {
	for _, w := range widgets {
		if w.WidgetId != nil && *w.WidgetId == widgetId {
			return w
		}
	}

	return nil
}
