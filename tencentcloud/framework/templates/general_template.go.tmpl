// Create handles `terraform apply` for new resources.
func (r *DemoWidgetResource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
	var plan DemoWidgetResourceModel
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: request naming — EVERY initialized request/response is named
	// after its actual API (camelCase + Request suffix: CreateWidget ->
	// createWidgetRequest), with NO exceptions for single-API methods or
	// if-scopes: the name alone tells you which API it serves. NEVER
	// `request`, `request1`, or `readRequest`.
	createWidgetRequest := demov20230101.NewCreateWidgetRequest()
	createWidgetRequest.Name = plan.Name.ValueStringPointer()
	createWidgetRequest.ZoneId = plan.ZoneId.ValueStringPointer()
	// TEMPLATE: optional attributes are only sent when known; keep this
	// null/unknown guard for every Optional field.
	if !plan.Remark.IsNull() && !plan.Remark.IsUnknown() {
		createWidgetRequest.Remark = plan.Remark.ValueStringPointer()
	}

	// TEMPLATE: optional lists expand with ElementsAs:
	if !plan.Tags.IsNull() && !plan.Tags.IsUnknown() {
		var tags []types.String
		resp.Diagnostics.Append(plan.Tags.ElementsAs(ctx, &tags, false)...)
		if resp.Diagnostics.HasError() {
			return
		}

		createWidgetRequest.Tags = make([]*string, 0, len(tags))
		for _, v := range tags {
			if v.IsNull() || v.IsUnknown() {
				continue
			}

			val := v.ValueString()
			createWidgetRequest.Tags = append(createWidgetRequest.Tags, &val)
		}
	}

	// TEMPLATE: never dereference r.Client() without the nil guard; report
	// "Provider not configured" exactly like this.
	if r.Client() == nil {
		resp.Diagnostics.AddError(
			"Provider not configured",
			"The provider client is not available. This is unexpected; please report it.",
		)

		return
	}

	service := NewDemoService(r.Client())
	// TEMPLATE: widgetId below is the value of the JSON resource_id field
	// from the create response — the service method returns it.
	widgetId, err := service.CreateWidget(ctx, createWidgetRequest)
	if err != nil {
		resp.Diagnostics.AddError(
			"Error creating Demo widget",
			fmt.Sprintf("CreateWidget failed: %v", err),
		)

		return
	}

	// TEMPLATE: never write an empty id into state.
	if widgetId == "" {
		resp.Diagnostics.AddError(
			"Error creating Demo widget",
			"CreateWidget returned an empty widget id.",
		)

		return
	}

	// TEMPLATE: composite id when several values address the resource on the
	// cloud side: fwHelper.IdFormat(a, b). Use the single id otherwise.
	plan.Id = types.StringValue(widgetId)

	// TEMPLATE: Computed attributes are unknown at this point and a state
	// cannot hold unknown values — normalize them to null before the
	// defensive persist below (see normalizeComputedUnknowns).
	normalizeDemoWidgetComputedUnknowns(&plan)

	// Persist the identity before reading back so a partial failure still
	// leaves a destroyable resource in state.
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: async API — when the JSON input carries async_info for the
	// create API, the service method returns a task id that must be waited
	// on BEFORE reading back. The wait takes a timeout parameter: pass the
	// product's dedicated tccommon wait constant when one exists, or a
	// sensible default agreed with the user:
	//   if err := service.WaitDemoTaskResult(ctx, taskId, tccommon.DefaultWaitTimeout); err != nil { ... }

	// TEMPLATE: read-back — same request form as Read; the caller picks
	// its own item from the list.
	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}
	widgets, _, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget after create", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)
	if item == nil {
		resp.Diagnostics.AddError(
			"Demo widget not readable after create",
			fmt.Sprintf("widget %s was created but cannot be read back", plan.Id.ValueString()),
		)

		return
	}

	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &plan, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
}

// Read handles `terraform refresh` and post-apply state refresh.
func (r *DemoWidgetResource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
	var state DemoWidgetResourceModel
	resp.Diagnostics.Append(req.State.Get(ctx, &state)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: composite ids are split with fwHelper.IdParseErr(id, n);
	// single ids are used as-is.
	widgetId := state.Id.ValueString()

	// TEMPLATE: read — build the describe request HERE (id -> request),
	// call the service with (ctx, request), pick this resource's own item
	// from the returned list, then map it into state (refresh + Set).
	// "No match in the list" is not-found -> RemoveResource.
	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}

	service := NewDemoService(r.Client())
	widgets, _, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)

	// Confirmed "not found" on the cloud side => drop it from state so
	// Terraform plans a recreation.
	if item == nil {
		resp.Diagnostics.AddWarning(
			"Resource not found",
			fmt.Sprintf("Demo widget %s not found, removing from state.", state.Id.ValueString()),
		)

		resp.State.RemoveResource(ctx)
		return
	}

	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &state, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &state)...)
}

// Update handles in-place modifications. TEMPLATE: when the cloud has no
// update API at all, implement Update as a no-op return and mark every
// mutable attribute RequiresReplace; when update is only partial, mark the
// non-updatable attributes RequiresReplace.
func (r *DemoWidgetResource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
	var plan DemoWidgetResourceModel
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	var state DemoWidgetResourceModel
	resp.Diagnostics.Append(req.State.Get(ctx, &state)...)
	if resp.Diagnostics.HasError() {
		return
	}

	widgetId := state.Id.ValueString()

	modifyWidgetRequest := demov20230101.NewModifyWidgetRequest()
	modifyWidgetRequest.WidgetId = fwHelper.String(widgetId)
	if !plan.Name.IsNull() && !plan.Name.IsUnknown() {
		modifyWidgetRequest.Name = plan.Name.ValueStringPointer()
	}

	if !plan.Remark.IsNull() && !plan.Remark.IsUnknown() {
		modifyWidgetRequest.Remark = plan.Remark.ValueStringPointer()
	}

	service := NewDemoService(r.Client())
	if err := service.ModifyWidget(ctx, modifyWidgetRequest); err != nil {
		resp.Diagnostics.AddError(
			"Error updating Demo widget",
			fmt.Sprintf("ModifyWidget failed: %v", err),
		)

		return
	}

	// TEMPLATE: when the update API is async (async_info present), wait for
	// the task here before the read-back.

	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}
	widgets, _, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget after update", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)
	if item == nil {
		resp.Diagnostics.AddError(
			"Demo widget not readable after update",
			fmt.Sprintf("widget %s was updated but cannot be read back", state.Id.ValueString()),
		)

		return
	}

	plan.Id = state.Id
	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &plan, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
}

