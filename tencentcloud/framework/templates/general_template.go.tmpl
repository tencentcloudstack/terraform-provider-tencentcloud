	resp.Schema = schema.Schema{
		Description: "Provides a resource to manage a Demo widget.",
		Attributes: map[string]schema.Attribute{
			"id": schema.StringAttribute{
				Computed:    true,
				Description: "ID of the resource.",
				PlanModifiers: []planmodifier.String{
					stringplanmodifier.UseStateForUnknown(),
				},
			},
			"name": schema.StringAttribute{
				Required:    true,
				Description: "Name of the widget.",
			},
			// TEMPLATE: attributes without Update API coverage must carry
			// RequiresReplace so Terraform recreates instead of diffing
			// forever.
			"zone_id": schema.StringAttribute{
				Required:    true,
				Description: "Zone ID.",
				PlanModifiers: []planmodifier.String{
					stringplanmodifier.RequiresReplace(),
				},
			},
			"remark": schema.StringAttribute{
				Optional:    true,
				Description: "Remark of the widget.",
			},
			// TEMPLATE: attribute shape selection — repeated scalars use
			// schema.ListAttribute (order matters) or schema.SetAttribute
			// (order-insensitive, common for cloud tag/id sets); repeated
			// structs use schema.ListNestedAttribute (see the data-source
			// template) or schema.SingleNestedAttribute for a single object
			// (see the config template).
			"tags": schema.ListAttribute{
				Optional:    true,
				ElementType: types.StringType,
				Description: "Tag list.",
			},
			// TEMPLATE: HARD RULE — Computed MINIMALISM: default Computed is
			// ONLY the resource id; extra read-back fields (status/create_on
			// below) only on explicit user request; async task ids NEVER
			// (conventions.md section 2). Cloud-set Computed attributes need
			// UseStateForUnknown.
			"status": schema.StringAttribute{
				Computed:    true,
				Description: "Status of the widget.",
				PlanModifiers: []planmodifier.String{
					stringplanmodifier.UseStateForUnknown(),
				},
			},
			"create_on": schema.StringAttribute{
				Computed:    true,
				Description: "Creation time.",
			},
			// TEMPLATE: the `timeouts` block — REQUIRED whenever any CUD API
