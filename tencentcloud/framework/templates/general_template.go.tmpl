// defaultDemoWidgetAsyncTimeout is the built-in maximum duration to wait for
// an async widget task when the user does not override it through the
// `timeouts` block, e.g. `timeouts { create = "30m" }`.
// TEMPLATE: choose the default per the product documentation or agreement
// with the user.
const defaultDemoWidgetAsyncTimeout = 15 * time.Minute

// demoWidgetTimeoutsBlock builds the `timeouts` block from the official
// terraform-plugin-framework-timeouts module. That module leaves the block
// itself undescribed (only the attributes carry descriptions), so the block
// description is restored here to keep the schema self-explanatory (golden
// source: mongodbRestoreDbInstanceTimeoutsBlock).
func demoWidgetTimeoutsBlock(ctx context.Context) schema.Block {
	block := resourcetimeouts.Block(ctx, resourcetimeouts.Opts{
		Create:            true,
		Update:            true,
		Delete:            true,
		CreateDescription: "A string that can be parsed as a duration (https://pkg.go.dev/time#ParseDuration), e.g. `30m`. It limits how long to wait for the asynchronous creation task. Default is `15m`.",
		UpdateDescription: "A string that can be parsed as a duration (https://pkg.go.dev/time#ParseDuration), e.g. `30m`. It limits how long to wait for the asynchronous update task. Default is `15m`.",
		DeleteDescription: "A string that can be parsed as a duration (https://pkg.go.dev/time#ParseDuration), e.g. `30m`. It limits how long to wait for the asynchronous deletion task. Default is `15m`.",
	})

	if nested, ok := block.(schema.SingleNestedBlock); ok {
		nested.Description = "The timeouts block allows you to specify the timeout for the create/update/delete operations."
		return nested
	}

	return block
}

// Create handles `terraform apply` for new resources.
func (r *DemoWidgetResource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
	var plan DemoWidgetResourceModel
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: request naming — named after the actual API
	// (CreateWidget -> createWidgetRequest), never `request`/`request1`
	// (conventions.md section 3).
	createWidgetRequest := demov20230101.NewCreateWidgetRequest()
	createWidgetRequest.Name = plan.Name.ValueStringPointer()
	createWidgetRequest.ZoneId = plan.ZoneId.ValueStringPointer()
	// TEMPLATE: optional attributes are only sent when known; keep this
	// null/unknown guard for every Optional field.
	if !plan.Remark.IsNull() && !plan.Remark.IsUnknown() {
		createWidgetRequest.Remark = plan.Remark.ValueStringPointer()
	}

	// TEMPLATE: an Optional collection that the SDK takes as []*string is
	// expanded with fwHelper.PointersFromList[E] (PointersFromSet for a Set;
	// E = the SDK element type: string / int64 / uint64 / float64 / bool).
	// null/unknown yields nil ("do not send this field"); null elements are
	// skipped; an unknown element or an element E cannot represent is an error
	// diagnostic. Never hand-roll this loop.
	createWidgetRequest.Tags = fwHelper.PointersFromList[string](ctx, plan.Tags, &resp.Diagnostics)
	if resp.Diagnostics.HasError() {
		return
	}

	service := NewDemoService(r.Client())

	// TEMPLATE: the timeout is resolved BEFORE the write API, so a malformed
	// duration fails the apply without any cloud-side effect. Timeouts.Create
	// resolves "user value wins, default fallback" in one call — the default
	// passed here MUST be the SAME constant the schema description mentions
	// (defaultDemoWidgetAsyncTimeout, `15m`). A resource whose create API is
	// synchronous drops the timeout, the taskId result and the wait below.
	timeout, timeoutDiags := plan.Timeouts.Create(ctx, defaultDemoWidgetAsyncTimeout)
	resp.Diagnostics.Append(timeoutDiags...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: widgetId below is the value of the JSON resource_id field
	// from the create response — the service method returns it. taskId is
	// the async task id (LOCAL variable: it only feeds the wait below and
	// never lands in the schema or the model); a SYNCHRONOUS create API
	// drops taskId from the service signature and the wait block below.
	widgetId, taskId, err := service.CreateWidget(ctx, createWidgetRequest)
	if err != nil {
		resp.Diagnostics.AddError(
			"Error creating Demo widget",
			fmt.Sprintf("CreateWidget failed: %v", err),
		)

		return
	}

	// TEMPLATE: never write an empty id into state.
	if widgetId == "" {
		resp.Diagnostics.AddError(
			"Error creating Demo widget",
			"CreateWidget returned an empty widget id.",
		)

		return
	}

	// TEMPLATE: composite id when several values address the resource on the
	// cloud side: fwHelper.IdFormat(a, b). Use the single id otherwise.
	plan.Id = types.StringValue(widgetId)

	// TEMPLATE: Computed attributes are unknown at this point and a state
	// cannot hold unknown values — normalize them to null before the
	// defensive persist below (see normalizeComputedUnknowns).
	normalizeDemoWidgetComputedUnknowns(&plan)

	// Persist the identity before reading back so a partial failure still
	// leaves a destroyable resource in state.
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: async create — the task MUST be waited on BEFORE reading
	// back, and AFTER the identity was persisted above (a failed or
	// timed-out wait must still leave a destroyable resource in state).
	if err := service.WaitDemoTaskResult(ctx, taskId, timeout); err != nil {
		resp.Diagnostics.AddError(
			"Error waiting for Demo widget task",
			fmt.Sprintf("widget task wait failed: %v", err),
		)

		return
	}

	// TEMPLATE: read-back — same request form as Read; the caller picks
	// its own item from the list.
	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}
	widgets, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget after create", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)
	if item == nil {
		resp.Diagnostics.AddError(
			"Demo widget not readable after create",
			fmt.Sprintf("widget %s was created but cannot be read back", plan.Id.ValueString()),
		)

		return
	}

	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &plan, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
}

// Read handles `terraform refresh` and post-apply state refresh.
func (r *DemoWidgetResource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
	var state DemoWidgetResourceModel
	resp.Diagnostics.Append(req.State.Get(ctx, &state)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TEMPLATE: composite ids are split with fwHelper.IdParseErr(id, n);
	// single ids are used as-is.
	widgetId := state.Id.ValueString()

	// TEMPLATE: read — build the describe request HERE (id -> request),
	// call the service with (ctx, request), pick this resource's own item
	// from the returned list, then map it into state (refresh + Set).
	// "No match in the list" is not-found -> RemoveResource.
	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}

	service := NewDemoService(r.Client())

	widgets, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)

	// Confirmed "not found" on the cloud side => drop it from state so
	// Terraform plans a recreation.
	// TEMPLATE: the not-found judgement stays INLINE in Read (RemoveResource
	// followed by an immediate return). Never move it into a shared refresh
	// helper: a later unconditional State.Set would overwrite the removal
	// (verified bug: tdmysql v2, 2026-11).
	if item == nil {
		resp.Diagnostics.AddWarning(
			"Resource not found",
			fmt.Sprintf("Demo widget %s not found, removing from state.", state.Id.ValueString()),
		)

		resp.State.RemoveResource(ctx)
		return
	}

	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &state, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &state)...)
}

// Update handles in-place modifications. TEMPLATE: when the cloud has no
// update API at all, implement Update as a no-op return and mark every
// mutable attribute RequiresReplace; when update is only partial, mark the
// non-updatable attributes RequiresReplace.
func (r *DemoWidgetResource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
	var plan DemoWidgetResourceModel
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

	var state DemoWidgetResourceModel
	resp.Diagnostics.Append(req.State.Get(ctx, &state)...)
	if resp.Diagnostics.HasError() {
		return
	}

	widgetId := state.Id.ValueString()

	service := NewDemoService(r.Client())

	// TEMPLATE: call a write API ONLY when an attribute it covers changed. A
	// plan that differs from the state in the `timeouts` block alone also
	// reaches Update; sending the write API then is a pointless no-change
	// request that many cloud APIs reject. With several update APIs, guard
	// EACH call with the attributes that API is responsible for. The
	// read-back below runs either way, so Computed values are always known.
	if !plan.Name.Equal(state.Name) || !plan.Remark.Equal(state.Remark) {
		// TEMPLATE: the timeout is resolved BEFORE the write API, so a
		// malformed duration fails the apply without any cloud-side effect. A
		// resource whose update API is synchronous drops the timeout, the
		// taskId result and the wait.
		timeout, timeoutDiags := plan.Timeouts.Update(ctx, defaultDemoWidgetAsyncTimeout)
		resp.Diagnostics.Append(timeoutDiags...)
		if resp.Diagnostics.HasError() {
			return
		}

		modifyWidgetRequest := demov20230101.NewModifyWidgetRequest()
		modifyWidgetRequest.WidgetId = fwHelper.String(widgetId)
		if !plan.Name.IsNull() && !plan.Name.IsUnknown() {
			modifyWidgetRequest.Name = plan.Name.ValueStringPointer()
		}

		if !plan.Remark.IsNull() && !plan.Remark.IsUnknown() {
			modifyWidgetRequest.Remark = plan.Remark.ValueStringPointer()
		}

		taskId, err := service.ModifyWidget(ctx, modifyWidgetRequest)
		if err != nil {
			resp.Diagnostics.AddError(
				"Error updating Demo widget",
				fmt.Sprintf("ModifyWidget failed: %v", err),
			)

			return
		}

		if err := service.WaitDemoTaskResult(ctx, taskId, timeout); err != nil {
			resp.Diagnostics.AddError(
				"Error waiting for Demo widget update task",
				fmt.Sprintf("widget update task wait failed: %v", err),
			)

			return
		}
	}

	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	describeWidgetsRequest.WidgetIds = []*string{fwHelper.String(widgetId)}
	widgets, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError("Error reading Demo widget after update", err.Error())
		return
	}

	item := findDemoWidget(widgets, widgetId)
	if item == nil {
		resp.Diagnostics.AddError(
			"Demo widget not readable after update",
			fmt.Sprintf("widget %s was updated but cannot be read back", state.Id.ValueString()),
		)

		return
	}

	plan.Id = state.Id
	resp.Diagnostics.Append(refreshDemoWidgetModel(ctx, &plan, item)...)
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
}

// Delete handles resource deletion.
func (r *DemoWidgetResource) Delete(ctx context.Context, req resource.DeleteRequest, resp *resource.DeleteResponse) {
	var state DemoWidgetResourceModel
	resp.Diagnostics.Append(req.State.Get(ctx, &state)...)
	if resp.Diagnostics.HasError() {
		return
	}

	widgetId := state.Id.ValueString()

	// TEMPLATE: delete — build the delete request HERE (id -> request),
	// then call the service with (ctx, request).
	deleteWidgetRequest := demov20230101.NewDeleteWidgetRequest()
	deleteWidgetRequest.WidgetId = fwHelper.String(widgetId)

	service := NewDemoService(r.Client())

	// TEMPLATE: resolved BEFORE the write API (see Update). A synchronous
	// delete API drops the timeout and the wait.
	timeout, timeoutDiags := state.Timeouts.Delete(ctx, defaultDemoWidgetAsyncTimeout)
	resp.Diagnostics.Append(timeoutDiags...)
	if resp.Diagnostics.HasError() {
		return
	}

	if err := service.DeleteWidget(ctx, deleteWidgetRequest); err != nil {
		resp.Diagnostics.AddError(
			"Error deleting Demo widget",
			fmt.Sprintf("DeleteWidget failed: %v", err),
		)

		return
	}

	// TEMPLATE: the wait shape follows the polling API named by async_info:
	// task-id polling (WaitDemoTaskResult, as in Create/Update) or, shown
	// here, instance-status polling until the resource is gone
	// (WaitDemoWidgetDestroyed — an empty describe answer is the terminal
	// state, see service_template.go.tmpl).
	if err := service.WaitDemoWidgetDestroyed(ctx, widgetId, timeout); err != nil {
		resp.Diagnostics.AddError(
			"Error waiting for Demo widget deletion",
			fmt.Sprintf("widget deletion wait failed: %v", err),
		)

		return
	}
}

// refreshDemoWidgetModel copies cloud-owned fields into the model.
//
// TEMPLATE: two conversion families, chosen per attribute kind:
//   - USER-CONFIGURABLE attributes (Required, or Optional): a cloud-omitted
//     field keeps the previous value (fwHelper.StringValueOrPrev), otherwise
//     Terraform fails the post-apply consistency check with
//     "was <value>, but now null";
//   - COMPUTED-only attributes (status/create_on): they are never
//     configured, so the truthful refreshed value — including null — is
//     recorded as-is (fwHelper.StringPointerValueOrNull). StringValueOrPrev
//     is NOT for these: its own documentation excludes attributes whose
//     truthful refreshed value may be null.
func refreshDemoWidgetModel(ctx context.Context, m *DemoWidgetResourceModel, item *demov20230101.Widget) diag.Diagnostics {
	if item == nil {
		return nil
	}

	var diags diag.Diagnostics

	m.Name = fwHelper.StringValueOrPrev(item.Name, m.Name)
	m.ZoneId = fwHelper.StringValueOrPrev(item.ZoneId, m.ZoneId)
	m.Remark = fwHelper.StringValueOrPrev(item.Remark, m.Remark)

	// TEMPLATE: collections follow the same two families. A user-configurable
	// collection uses the *OrPrev form (cloud omitted -> keep prev; cloud
	// empty while the practitioner never set it -> null, avoiding "was null,
	// but now []"); a Computed-only collection uses fwHelper.ListFromPointers /
	// SetFromPointers (nil -> null, empty -> empty). elemType is the framework
	// type of the elements (types.StringType, types.Int64Type, ...).
	m.Tags = fwHelper.ListFromPointersOrPrev(ctx, types.StringType, item.Tags, m.Tags, &diags)

	m.Status = fwHelper.StringPointerValueOrNull(item.Status)
	m.CreateOn = fwHelper.StringPointerValueOrNull(item.CreateOn)

	return diags
}

// normalizeDemoWidgetComputedUnknowns rewrites unknown computed attributes to
// null so the model can be persisted into state before the read-back fills
// them with the cloud-side values.
func normalizeDemoWidgetComputedUnknowns(m *DemoWidgetResourceModel) {
	if m.Status.IsUnknown() {
		m.Status = types.StringNull()
	}

	if m.CreateOn.IsUnknown() {
		m.CreateOn = types.StringNull()
	}
}

// findDemoWidget picks this resource's own item from a describe list —
// the demo for the LIST-QUERY shape. When the describe API supports EXACT
// lookup (single item returned directly), DROP this helper and use the
// item straight away (conventions.md section 3).
func findDemoWidget(widgets []*demov20230101.Widget, widgetId string) *demov20230101.Widget {
	for _, w := range widgets {
		if w.WidgetId != nil && *w.WidgetId == widgetId {
			return w
		}
	}

	return nil
}
