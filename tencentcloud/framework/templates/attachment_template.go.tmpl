type DemoWidgetAttachmentResourceModel struct {
	Id          types.String `tfsdk:"id"`
	GadgetId    types.String `tfsdk:"gadget_id"`
	WidgetId    types.String `tfsdk:"widget_id"`
	BindMode    types.String `tfsdk:"bind_mode"`
