// TEMPLATE: framework action skeleton.
// Golden sources:
//   - simple: tencentcloud/services/antiddos/action_tc_antiddos_unblock_resources.go
//   - complex (write + wait):
//     tencentcloud/services/ssl/action_tc_ssl_upload_certificate_instance.go
//
// Location: tencentcloud/services/<product>/action_tc_<product>_<name>.go
// Factory naming: New<Product><Name> (no "Action" suffix).
//
// Actions are one-shot operations: they have Invoke only, no cloud-side
// lifecycle and NO STATE. Typical use cases: batch operations,
// apply-for-unblock, upload-certificate-like flows.
//
// TEMPLATE: HARD FACTS about the framework action API (verified against the
// vendored terraform-plugin-framework — generated code that violates any of
// them does not compile):
//   - action.InvokeResponse has NO State field: an action never writes
//     state, so there is NO `id` attribute and NO resp.State.Set call;
//   - action/schema attributes have NO Computed / Default / PlanModifiers:
//     an action schema holds ONLY input attributes (Required / Optional /
//     Sensitive) — never output attributes;
//   - the `timeouts` block lives in schema.Blocks, never in Attributes;
//   - every Invoke result is communicated through resp.Diagnostics only.
//
// TEMPLATE: async ids (FlowId/TaskId) have EXACTLY ONE purpose — serving as
// the input of the async task-query API. They NEVER appear in the schema or
// the model. TWO wait shapes exist — task-id OR instance-status polling
// (the polling API decides; the task id field name follows the vendored SDK,
// see service_template.go.tmpl).

package demo

import (
	"context"
	"fmt"
	"time"

	"github.com/hashicorp/terraform-plugin-framework/action"
	"github.com/hashicorp/terraform-plugin-framework/action/schema"
	"github.com/hashicorp/terraform-plugin-framework/types"

	actiontimeouts "github.com/hashicorp/terraform-plugin-framework-timeouts/action/timeouts"

	demov20230101 "github.com/tencentcloud/tencentcloud-sdk-go/tencentcloud/demo/v20230101"

	"github.com/tencentcloudstack/terraform-provider-tencentcloud/tencentcloud/framework/fw"
)

var _ action.ActionWithConfigure = &DemoRestartWidget{}

// NewDemoRestartWidget is the factory referenced by
// tencentcloud/framework/registry.go to register this action.
func NewDemoRestartWidget() action.Action {
	return &DemoRestartWidget{}
}

// DemoRestartWidget implements action.Action for
// tencentcloud_demo_restart_widget.
type DemoRestartWidget struct {
	fw.ActionWithConfigure
}

// DemoRestartWidgetModel maps the schema attributes: INPUT attributes only
// (an action has no state, hence no id and no output attributes).
type DemoRestartWidgetModel struct {
	WidgetId types.String `tfsdk:"widget_id"`
	// TEMPLATE: the `timeouts` block from the official
	// terraform-plugin-framework-timeouts module — declared whenever the
	// invoke involves an async API (async_info), so the wait deadline is
	// user-configurable. Purely synchronous actions drop it (field, block,
	// constant, wait).
	Timeouts actiontimeouts.Value `tfsdk:"timeouts"`
}

func (a *DemoRestartWidget) Metadata(_ context.Context, _ action.MetadataRequest, resp *action.MetadataResponse) {
	resp.TypeName = "tencentcloud_demo_restart_widget"
}

func (a *DemoRestartWidget) Schema(ctx context.Context, _ action.SchemaRequest, resp *action.SchemaResponse) {
	// TEMPLATE: every attribute Description below is a PLACEHOLDER — in
	// generated code it is the faithful professional EN translation of the
	// IACP CapiParam.Document field description (HTML stripped). NO
	// embellishment, NO extra wording, NO fixing of metadata mistakes: stay
	// consistent with the IACP metadata even when it is wrong (see
	// conventions.md section 2).
	resp.Schema = schema.Schema{
		Description: "Provides an action to restart a Demo widget via the " +
			"RestartWidget API. This is a one-time operation; no cloud-side state is persisted.",
		Attributes: map[string]schema.Attribute{
			"widget_id": schema.StringAttribute{
				Required:    true,
				Description: "ID of the widget to restart.",
			},
		},
		// TEMPLATE: the `timeouts` block — REQUIRED when the invoke
		// involves an async API (async_info), dropped for purely
		// synchronous actions. A block is NOT an attribute: it lives in
		// the schema Blocks map.
		Blocks: map[string]schema.Block{
			"timeouts": demoRestartWidgetTimeoutsBlock(ctx),
		},
	}
}

// defaultDemoRestartWidgetInvokeTimeout is the built-in maximum duration to
// wait for the async restart task when the user does not override it through
// the `timeouts` block, e.g. `timeouts { invoke = "30m" }`.
// TEMPLATE: choose the default per the product documentation or agreement
// with the user.
const defaultDemoRestartWidgetInvokeTimeout = 15 * time.Minute

// demoRestartWidgetTimeoutsBlock builds the `timeouts` block from the
// official terraform-plugin-framework-timeouts module (golden source:
// sslUploadCertificateInstanceTimeoutsBlock).
func demoRestartWidgetTimeoutsBlock(ctx context.Context) schema.Block {
	block := actiontimeouts.BlockWithOpts(ctx, actiontimeouts.Opts{
		InvokeDescription: "A string that can be parsed as a duration (https://pkg.go.dev/time#ParseDuration), e.g. `15m`. " +
			"It limits how long the action waits for the asynchronous restart task to complete. Default is `15m`.",
	})

	if nested, ok := block.(schema.SingleNestedBlock); ok {
		nested.Description = "The timeouts block allows you to specify the timeout for the invoke operation."
		return nested
	}

	return block
}

// Invoke is called to run the logic of the action.
func (a *DemoRestartWidget) Invoke(ctx context.Context, req action.InvokeRequest, resp *action.InvokeResponse) {
	var data DemoRestartWidgetModel
	resp.Diagnostics.Append(req.Config.Get(ctx, &data)...)
	if resp.Diagnostics.HasError() {
		return
	}

	widgetId := data.WidgetId.ValueString()
	if widgetId == "" {
		resp.Diagnostics.AddError("Missing widget_id", "widget_id is required and cannot be empty.")
		return
	}

	// TEMPLATE: an unset/null timeouts block falls back to the default
	// constant — the SAME constant the schema description mentions. The
	// resolve happens BEFORE the write API so a malformed duration fails
	// the action without any cloud-side effect.
	timeout, timeoutDiags := data.Timeouts.Invoke(ctx, defaultDemoRestartWidgetInvokeTimeout)
	resp.Diagnostics.Append(timeoutDiags...)
	if resp.Diagnostics.HasError() {
		return
	}

	restartWidgetRequest := demov20230101.NewRestartWidgetRequest()
	restartWidgetRequest.WidgetId = &widgetId

	service := NewDemoService(a.Client())

	// TEMPLATE: the flow/task id returned by the API is a LOCAL variable
	// with exactly one purpose — feeding the async task-query API below.
	// It NEVER lands in the schema or the model.
	flowId, err := service.RestartWidget(ctx, restartWidgetRequest)
	if err != nil {
		resp.Diagnostics.AddError(
			"Error restarting Demo widget",
			fmt.Sprintf("RestartWidget failed: %v", err),
		)

		return
	}

	// TEMPLATE: async action — wait for the task before Invoke returns.
	// Purely synchronous actions delete this block AND the flowId local
	// (use `_, err := ...` or a single-value service signature), otherwise
	// the compiler reports "declared and not used".
	if err := service.WaitDemoTaskResult(ctx, flowId, timeout); err != nil {
		resp.Diagnostics.AddError(
			"Error waiting for Demo widget restart task",
			fmt.Sprintf("restart task wait failed: %v", err),
		)

		return
	}
}
