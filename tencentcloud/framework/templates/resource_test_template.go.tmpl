const (
	demoTestWidgetId = "widget-12345"
	demoTestName     = "tf-example-widget"
	demoTestZoneId   = "zone-12345"
)

// TEMPLATE: stub helpers (ptrXxx / buildXxx) — only keep the ones actually
// referenced by the test cases; staticcheck U1000 (or a manual reference
// count) must find ZERO unused private functions/variables/constants in the
// final file. After fixing a bug, re-check helpers the fix made obsolete.
func demoStr(v string) *string { return &v }

// demoTestWidget builds the DescribeWidgets response item.
func demoTestWidget() *demov20230101.Widget {
	return &demov20230101.Widget{
		WidgetId: demoStr(demoTestWidgetId),
		Name:     demoStr(demoTestName),
		ZoneId:   demoStr(demoTestZoneId),
		Status:   demoStr("Running"),
		CreateOn: demoStr("2024-01-01T00:00:00Z"),
	}
}

// demoTestModel builds the terraform model used for plan/state.
// TEMPLATE: every unset attribute carries an EXPLICIT TYPED null value —
// the raw zero value (types.List{} etc.) breaks tfsdk Plan/State
// reflection with "Value Conversion Error". Populate one typed null per
// model field: Int64Null/StringNull/BoolNull/Float64Null for scalars,
// ListNull(ElementType) for lists, ListNull(ObjectType{AttrTypes}) for
// nested lists, plus the Timeouts value below. A single missing typed
// null fails the whole test context.
// TEMPLATE: CONDITIONAL — generate the Timeouts initialization and the
// attrTypes helper ONLY when the resource schema declares the `timeouts`
// block (async scenarios); purely synchronous resources drop the field,
// the helper and the attr/resourcetimeouts imports. The value itself:
// cases exercising a wait path pass a SECOND-SCALE short user value (5s
// below is a recommended example, not a fixed answer — the test verifies
// the code path is REACHED, never hard-waits a realistic minute-scale
// default; a stub that misses its terminal state would otherwise hang
// the test for the whole default). Cases unrelated to timeouts keep the
// plain null form (types.ObjectNull(...)). The widget create/delete
// cases below wait for async tasks, hence the short-value form here.
func demoTestModel() svdemo.DemoWidgetResourceModel {
	return svdemo.DemoWidgetResourceModel{
		Id:     types.StringValue(demoTestWidgetId),
		Name:   types.StringValue(demoTestName),
		ZoneId: types.StringValue(demoTestZoneId),
		// Every remaining model field gets an explicit typed null — one per
		// field, none skipped (Computed ones are filled by the refresh).
		Remark:   types.StringNull(),
		Tags:     types.ListNull(types.StringType),
		Status:   types.StringNull(),
		CreateOn: types.StringNull(),
		// TEMPLATE: CONDITIONAL (async only) — a short (e.g. 5s) user value
		// for the wait-path cases; ObjectNull for unrelated ones. Use
		// ObjectValueMust: the plain ObjectValue returns (value, diags) and
		// does NOT compile inline (verified: tdmysql v2, 2026-11).
		// Update-case stubs must reflect the POST-change cloud state.
		Timeouts: resourcetimeouts.Value{Object: types.ObjectValueMust(
			demoWidgetTimeoutsAttrTypes(),
			map[string]attr.Value{
				"create": types.StringValue("5s"),
				"update": types.StringValue("5s"),
				"delete": types.StringValue("5s"),
			},
		)},
	}
}

// demoWidgetTimeoutsAttrTypes mirrors the attribute types of the timeouts
// block declared by the resource schema.
// TEMPLATE: CONDITIONAL — only for resources with a timeouts block; the
// stages MUST match the resource's resourcetimeouts.Block Opts.
func demoWidgetTimeoutsAttrTypes() map[string]attr.Type {
	return map[string]attr.Type{
		"create": types.StringType,
		"update": types.StringType,
		"delete": types.StringType,
	}
}

// assertDemoWidgetModel asserts every model field.
func assertDemoWidgetModel(t *testing.T, m svdemo.DemoWidgetResourceModel) {
	t.Helper()

	if m.Id.ValueString() != demoTestWidgetId {
		t.Errorf("id = %q, want %q", m.Id.ValueString(), demoTestWidgetId)
	}
	if m.Name.ValueString() != demoTestName {
		t.Errorf("name = %q, want %q", m.Name.ValueString(), demoTestName)
	}
	if m.Status.ValueString() != "Running" {
		t.Errorf("status = %q, want Running", m.Status.ValueString())
	}
}

// patchDemoSdkClient stubs the versioned client accessor and returns the
// mock SDK client whose methods the test patches next (the two-level mode).
func patchDemoSdkClient(patches *gomonkey.Patches, client *connectivity.TencentCloudClient) *demov20230101.Client {
	demoClient := &demov20230101.Client{}
	patches.ApplyMethodReturn(client, "UseDemoV20230101Client", demoClient)

	return demoClient
}

// demoWidgetTestContext wires the resource to a configured client; the SDK
// client methods are stubbed per test case.
type demoWidgetTestContext struct {
	resource resource.Resource
	schema   schema.Schema
	client   *connectivity.TencentCloudClient
}

func newDemoWidgetTestContext(t *testing.T) *demoWidgetTestContext {
	t.Helper()

	connectivityClient := &connectivity.TencentCloudClient{}

	res := svdemo.NewDemoWidgetResource()
	configured, ok := res.(resource.ResourceWithConfigure)
	if !ok {
		t.Fatalf("resource does not implement resource.ResourceWithConfigure")
	}

	var configureResp resource.ConfigureResponse
	configured.Configure(
		context.Background(),
		resource.ConfigureRequest{ProviderData: &sharedmeta.ProviderMeta{Client: connectivityClient}},
		&configureResp,
	)
	if configureResp.Diagnostics.HasError() {
		t.Fatalf("failed to configure resource: %v", configureResp.Diagnostics.Errors())
	}

	var schemaResp resource.SchemaResponse
	res.Schema(context.Background(), resource.SchemaRequest{}, &schemaResp)
	if schemaResp.Diagnostics.HasError() {
		t.Fatalf("failed to build schema: %v", schemaResp.Diagnostics.Errors())
	}

	return &demoWidgetTestContext{resource: res, schema: schemaResp.Schema, client: connectivityClient}
}

func (c *demoWidgetTestContext) plan(t *testing.T, m svdemo.DemoWidgetResourceModel) tfsdk.Plan {
	t.Helper()

	plan := tfsdk.Plan{Schema: c.schema}
	if diags := plan.Set(context.Background(), m); diags.HasError() {
		t.Fatalf("failed to build plan: %v", diags.Errors())
	}

	return plan
}

func (c *demoWidgetTestContext) state(t *testing.T, m svdemo.DemoWidgetResourceModel) tfsdk.State {
	t.Helper()

	state := tfsdk.State{Schema: c.schema}
	if diags := state.Set(context.Background(), m); diags.HasError() {
		t.Fatalf("failed to build state: %v", diags.Errors())
	}

	return state
}

// TestDemoWidgetCreateSuccess verifies that Create sends all request fields,
// tracks the returned widget id and refreshes the state.
func TestDemoWidgetCreateSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoSdkClient(patches, ctx.client)

	var captured *demov20230101.CreateWidgetRequest
	patches.ApplyMethodFunc(demoClient, "CreateWidget", func(req *demov20230101.CreateWidgetRequest) (*demov20230101.CreateWidgetResponse, error) {
		captured = req

		return &demov20230101.CreateWidgetResponse{Response: &demov20230101.CreateWidgetResponseParams{
			WidgetId:  demoStr(demoTestWidgetId),
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			WidgetSet: []*demov20230101.Widget{demoTestWidget()},
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})

	model := demoTestModel()
	var createResp resource.CreateResponse
	createResp.State = ctx.state(t, model)
	ctx.resource.Create(context.Background(), resource.CreateRequest{Plan: ctx.plan(t, model)}, &createResp)
	if createResp.Diagnostics.HasError() {
		t.Fatalf("Create failed: %v", createResp.Diagnostics.Errors())
	}

	if captured == nil {
		t.Fatal("CreateWidget request is nil")
	}
	if captured.Name == nil || *captured.Name != demoTestName {
		t.Errorf("create request name = %v, want %q", captured.Name, demoTestName)
	}
	if captured.ZoneId == nil || *captured.ZoneId != demoTestZoneId {
		t.Errorf("create request zone_id = %v, want %q", captured.ZoneId, demoTestZoneId)
	}

	var got svdemo.DemoWidgetResourceModel
	if diags := createResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	assertDemoWidgetModel(t, got)
}

// TestDemoWidgetCreateEmptyId verifies that Create fails loudly when the API
// returns no widget id.
func TestDemoWidgetCreateEmptyId(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoSdkClient(patches, ctx.client)
	patches.ApplyMethodFunc(demoClient, "CreateWidget", func(req *demov20230101.CreateWidgetRequest) (*demov20230101.CreateWidgetResponse, error) {
		return &demov20230101.CreateWidgetResponse{Response: &demov20230101.CreateWidgetResponseParams{
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})

	var createResp resource.CreateResponse
	createResp.State = ctx.state(t, demoTestModel())
	ctx.resource.Create(context.Background(), resource.CreateRequest{Plan: ctx.plan(t, demoTestModel())}, &createResp)
	if !createResp.Diagnostics.HasError() {
		t.Fatal("Create should fail when the API returns an empty widget id")
	}
}

