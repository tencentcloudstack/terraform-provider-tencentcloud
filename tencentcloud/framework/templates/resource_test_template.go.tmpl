// TestDemoWidgetUpdateSuccess verifies Update sends the PLANNED value to the
// modify request, waits for the task, and records the POST-update cloud state
// from the read-back — not the plan.
// TEMPLATE: the describe stub reports a value DIFFERENT from the plan (the
// cloud normalized it). Only a state built from the read-back can equal it: an
// Update that skips the read-back would persist the plan value and fail the
// final assertion. A stub that merely echoes the plan could not tell the two
// apart.
func TestDemoWidgetUpdateSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoWidgetSdkClient(patches, ctx.client)

	var captured *demov20230101.ModifyWidgetRequest
	patches.ApplyMethodFunc(demoClient, "ModifyWidget", func(req *demov20230101.ModifyWidgetRequest) (*demov20230101.ModifyWidgetResponse, error) {
		captured = req

		return &demov20230101.ModifyWidgetResponse{Response: &demov20230101.ModifyWidgetResponseParams{
			TaskId:    demoWidgetStr(demoWidgetTestTaskId),
			RequestId: demoWidgetStr("fake-request-id"),
		}}, nil
	})
	stubDemoWidgetTaskStatus(patches, demoClient, "SUCCESS")
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		normalized := demoWidgetTestItem()
		normalized.Name = demoWidgetStr(demoWidgetTestNormalizedName)

		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			WidgetSet: []*demov20230101.Widget{normalized},
			RequestId: demoWidgetStr("fake-request-id"),
		}}, nil
	})

	plannedModel := demoWidgetTestModel()
	plannedModel.Name = types.StringValue(demoWidgetTestRenamedName)

	var updateResp resource.UpdateResponse
	updateResp.State = ctx.state(t, demoWidgetTestModel())
	ctx.resource.Update(context.Background(),
		resource.UpdateRequest{
			Plan:  ctx.plan(t, plannedModel),
			State: ctx.state(t, demoWidgetTestModel()),
		}, &updateResp)
	if updateResp.Diagnostics.HasError() {
		t.Fatalf("Update failed: %v", updateResp.Diagnostics.Errors())
	}

	if captured == nil {
		t.Fatal("ModifyWidget request is nil")
	}
	if captured.WidgetId == nil || *captured.WidgetId != demoWidgetTestId {
		t.Errorf("update request widget_id = %v, want %q", captured.WidgetId, demoWidgetTestId)
	}
	if captured.Name == nil || *captured.Name != demoWidgetTestRenamedName {
		t.Errorf("update request name = %v, want the planned %q", captured.Name, demoWidgetTestRenamedName)
	}

	var got svdemo.DemoWidgetResourceModel
	if diags := updateResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	if got.Id.ValueString() != demoWidgetTestId {
		t.Errorf("id = %q, want the unchanged %q", got.Id.ValueString(), demoWidgetTestId)
	}
	if got.Name.ValueString() != demoWidgetTestNormalizedName {
		t.Errorf("name = %q, want the read-back cloud value %q", got.Name.ValueString(), demoWidgetTestNormalizedName)
	}
}

// TestDemoWidgetUpdateTimeoutsOnly verifies that a plan differing from the
// state in the `timeouts` block alone calls NO write API: no attribute the
// modify API covers changed, so the call would be a pointless no-change
// request. The read-back still runs and the new timeouts are persisted.
func TestDemoWidgetUpdateTimeoutsOnly(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoWidgetSdkClient(patches, ctx.client)

	modifyCalls := 0
	patches.ApplyMethodFunc(demoClient, "ModifyWidget", func(req *demov20230101.ModifyWidgetRequest) (*demov20230101.ModifyWidgetResponse, error) {
		modifyCalls++

		return nil, fmt.Errorf("the modify API must not be called")
	})
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			WidgetSet: []*demov20230101.Widget{demoWidgetTestItem()},
			RequestId: demoWidgetStr("fake-request-id"),
		}}, nil
	})

	plannedModel := demoWidgetTestModel()
	plannedModel.Timeouts = resourcetimeouts.Value{Object: types.ObjectValueMust(
		demoWidgetTimeoutsAttrTypes(),
		map[string]attr.Value{
			"create": types.StringValue("5s"),
			"update": types.StringValue("7s"),
			"delete": types.StringValue("5s"),
		},
	)}

	var updateResp resource.UpdateResponse
	updateResp.State = ctx.state(t, demoWidgetTestModel())
	ctx.resource.Update(context.Background(),
		resource.UpdateRequest{
			Plan:  ctx.plan(t, plannedModel),
			State: ctx.state(t, demoWidgetTestModel()),
		}, &updateResp)
	if updateResp.Diagnostics.HasError() {
		t.Fatalf("Update failed: %v", updateResp.Diagnostics.Errors())
	}
	if modifyCalls != 0 {
		t.Errorf("ModifyWidget was called %d time(s) for a timeouts-only change", modifyCalls)
	}

	var got svdemo.DemoWidgetResourceModel
	if diags := updateResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	assertDemoWidgetModel(t, got)
}

// TestDemoWidgetDeleteSuccess verifies Delete sends the delete request with
// the tracked id and then waits until the widget is gone.
func TestDemoWidgetDeleteSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoWidgetSdkClient(patches, ctx.client)

	var captured *demov20230101.DeleteWidgetRequest
	patches.ApplyMethodFunc(demoClient, "DeleteWidget", func(req *demov20230101.DeleteWidgetRequest) (*demov20230101.DeleteWidgetResponse, error) {
		captured = req

		return &demov20230101.DeleteWidgetResponse{Response: &demov20230101.DeleteWidgetResponseParams{
			RequestId: demoWidgetStr("fake-request-id"),
		}}, nil
	})
	// The instance-status wait polls the describe API; an empty answer is
	// the terminal "destroyed" state, reported on the first call.
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			RequestId: demoWidgetStr("fake-request-id"),
		}}, nil
	})

	var deleteResp resource.DeleteResponse
	ctx.resource.Delete(context.Background(), resource.DeleteRequest{State: ctx.state(t, demoWidgetTestModel())}, &deleteResp)
	if deleteResp.Diagnostics.HasError() {
		t.Fatalf("Delete failed: %v", deleteResp.Diagnostics.Errors())
	}

	if captured == nil {
		t.Fatal("DeleteWidget request is nil")
	}
	if captured.WidgetId == nil || *captured.WidgetId != demoWidgetTestId {
		t.Errorf("delete request widget_id = %v, want %q", captured.WidgetId, demoWidgetTestId)
	}
}
