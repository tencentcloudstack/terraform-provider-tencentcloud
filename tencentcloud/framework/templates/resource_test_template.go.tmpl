// TestDemoWidgetReadSuccess verifies Read refreshes all leaf fields.
func TestDemoWidgetReadSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoSdkClient(patches, ctx.client)

	var gotWidgetId string
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		if len(req.WidgetIds) != 1 || req.WidgetIds[0] == nil {
			t.Errorf("expected the widget id filter to be passed")
		} else {
			gotWidgetId = *req.WidgetIds[0]
		}

		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			WidgetSet: []*demov20230101.Widget{demoTestWidget()},
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})

	var readResp resource.ReadResponse
	readResp.State = ctx.state(t, demoTestModel())
	ctx.resource.Read(context.Background(), resource.ReadRequest{State: ctx.state(t, demoTestModel())}, &readResp)
	if readResp.Diagnostics.HasError() {
		t.Fatalf("Read failed: %v", readResp.Diagnostics.Errors())
	}

	if gotWidgetId != demoTestWidgetId {
		t.Errorf("DescribeWidgets called with %q, want %q", gotWidgetId, demoTestWidgetId)
	}

	var got svdemo.DemoWidgetResourceModel
	if diags := readResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	assertDemoWidgetModel(t, got)
}

// TestDemoWidgetReadNotFound verifies that a describe list without the
// tracked widget drops the resource from state (confirmed not-found).
func TestDemoWidgetReadNotFound(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoSdkClient(patches, ctx.client)
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})

	var readResp resource.ReadResponse
	readResp.State = ctx.state(t, demoTestModel())
	ctx.resource.Read(context.Background(), resource.ReadRequest{State: ctx.state(t, demoTestModel())}, &readResp)
	if readResp.Diagnostics.HasError() {
		t.Fatalf("Read should not error on confirmed not-found: %v", readResp.Diagnostics.Errors())
	}
	if !readResp.State.Raw.IsNull() {
		t.Error("state should be removed after the widget is confirmed gone")
	}
}

// TestDemoWidgetUpdateSuccess verifies Update sends the modify request and
// refreshes the state afterwards.
func TestDemoWidgetUpdateSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetTestContext(t)
	demoClient := patchDemoSdkClient(patches, ctx.client)

	var captured *demov20230101.ModifyWidgetRequest
	patches.ApplyMethodFunc(demoClient, "ModifyWidget", func(req *demov20230101.ModifyWidgetRequest) (*demov20230101.ModifyWidgetResponse, error) {
		captured = req

		return &demov20230101.ModifyWidgetResponse{Response: &demov20230101.ModifyWidgetResponseParams{
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})
	patches.ApplyMethodFunc(demoClient, "DescribeWidgets", func(req *demov20230101.DescribeWidgetsRequest) (*demov20230101.DescribeWidgetsResponse, error) {
		return &demov20230101.DescribeWidgetsResponse{Response: &demov20230101.DescribeWidgetsResponseParams{
			WidgetSet: []*demov20230101.Widget{demoTestWidget()},
			RequestId: demoStr("fake-request-id"),
		}}, nil
	})

	var updateResp resource.UpdateResponse
	updateResp.State = ctx.state(t, demoTestModel())
	ctx.resource.Update(context.Background(),
		resource.UpdateRequest{
			Plan:  ctx.plan(t, demoTestModel()),
			State: ctx.state(t, demoTestModel()),
		}, &updateResp)
	if updateResp.Diagnostics.HasError() {
		t.Fatalf("Update failed: %v", updateResp.Diagnostics.Errors())
