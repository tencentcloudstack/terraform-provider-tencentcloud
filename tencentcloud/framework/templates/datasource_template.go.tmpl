// Read queries the cloud API and writes the result into resp.State.
func (d *DemoWidgetsDataSource) Read(ctx context.Context, req datasource.ReadRequest, resp *datasource.ReadResponse) {
	var config DemoWidgetsDataSourceModel
	resp.Diagnostics.Append(req.Config.Get(ctx, &config)...)
	if resp.Diagnostics.HasError() {
		return
	}

	describeWidgetsRequest := demov20230101.NewDescribeWidgetsRequest()
	if !config.Name.IsNull() && !config.Name.IsUnknown() {
		describeWidgetsRequest.Name = config.Name.ValueStringPointer()
	}

	// TEMPLATE: an optional list filter that the SDK takes as []*string —
	// fwHelper.PointersFromList[string] (null/unknown -> nil, i.e. no filter).
	describeWidgetsRequest.WidgetIds = fwHelper.PointersFromList[string](ctx, config.WidgetIds, &resp.Diagnostics)
	if resp.Diagnostics.HasError() {
		return
	}

	service := NewDemoService(d.Client())

	// TEMPLATE: when the API pages, the service method internally loops
	// (Offset/Limit) and returns the full list — this file never loops by
	// itself and never surfaces the total count.
	widgets, err := service.DescribeWidgets(ctx, describeWidgetsRequest)
	if err != nil {
		resp.Diagnostics.AddError(
			"Error querying Demo widgets",
			fmt.Sprintf("DescribeWidgets failed: %v", err),
		)

		return
	}

	// An empty result is a genuinely empty list, not a failure.
	items := make([]DemoWidgetItemModel, 0, len(widgets))
	for _, item := range widgets {
		if item == nil {
			continue
		}

		items = append(items, DemoWidgetItemModel{
			WidgetId: types.StringPointerValue(item.WidgetId),
			Name:     types.StringPointerValue(item.Name),
			Status:   types.StringPointerValue(item.Status),
			CreateOn: types.StringPointerValue(item.CreateOn),
		})
	}

	list, diags := types.ListValueFrom(ctx, types.ObjectType{AttrTypes: DemoWidgetItemAttrTypes}, items)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}

	config.WidgetSet = list

	// The state id is a random token (JSON resource_id = fwHelper.BuildToken()).
	config.Id = types.StringValue(fwHelper.BuildToken())

	resp.Diagnostics.Append(resp.State.Set(ctx, &config)...)
}
