	}

	return state
}

// TestDemoWidgetAttachmentCreateSuccess verifies Create sends the bind
// request, composes the parent-first composite id and records the binding
// read back from the parent describe.
func TestDemoWidgetAttachmentCreateSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetAttachmentTestContext(t)
	demoClient := patchDemoWidgetAttachmentSdkClient(patches, ctx.client)

	var captured *demov20230101.AttachWidgetRequest
	patches.ApplyMethodFunc(demoClient, "AttachWidget", func(request *demov20230101.AttachWidgetRequest) (*demov20230101.AttachWidgetResponse, error) {
		captured = request

		return &demov20230101.AttachWidgetResponse{Response: &demov20230101.AttachWidgetResponseParams{
			RequestId: demoWidgetAttachmentStr("fake-request-id"),
		}}, nil
	})
	stubDemoWidgetAttachmentDescribe(patches, demoClient, []*demov20230101.Gadget{demoWidgetAttachmentTestGadget()})

	model := demoWidgetAttachmentTestModel()
	var createResp resource.CreateResponse
	createResp.State = ctx.state(t, model)
	ctx.resource.Create(context.Background(), resource.CreateRequest{Plan: ctx.plan(t, model)}, &createResp)
	if createResp.Diagnostics.HasError() {
		t.Fatalf("Create failed: %v", createResp.Diagnostics.Errors())
	}

	if captured == nil {
		t.Fatal("AttachWidget request is nil")
	}
	if captured.GadgetId == nil || *captured.GadgetId != demoWidgetAttachmentTestGadgetId {
		t.Errorf("bind request gadget_id = %v, want %q", captured.GadgetId, demoWidgetAttachmentTestGadgetId)
	}
	if captured.WidgetId == nil || *captured.WidgetId != demoWidgetAttachmentTestWidgetId {
		t.Errorf("bind request widget_id = %v, want %q", captured.WidgetId, demoWidgetAttachmentTestWidgetId)
	}

	var got svdemo.DemoWidgetAttachmentResourceModel
	if diags := createResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	if got.Id.ValueString() != demoWidgetAttachmentTestId {
		t.Errorf("id = %q, want the parent-first composite %q", got.Id.ValueString(), demoWidgetAttachmentTestId)
	}
	if got.BoundStatus.ValueString() != demoWidgetAttachmentTestBoundStatus {
		t.Errorf("bound_status = %q, want %q", got.BoundStatus.ValueString(), demoWidgetAttachmentTestBoundStatus)
	}
}

