// TestDemoWidgetAttachmentImportState verifies the composite id is split into
// the id and both segment attributes.
func TestDemoWidgetAttachmentImportState(t *testing.T) {
	ctx := newDemoWidgetAttachmentTestContext(t)

	importer, ok := ctx.resource.(resource.ResourceWithImportState)
	if !ok {
		t.Fatal("resource does not implement resource.ResourceWithImportState")
	}

	resp := resource.ImportStateResponse{State: tfsdk.State{
		Schema: ctx.schema,
		Raw:    tftypes.NewValue(ctx.schema.Type().TerraformType(context.Background()), nil),
	}}
	importer.ImportState(context.Background(), resource.ImportStateRequest{ID: demoWidgetAttachmentTestId}, &resp)
	if resp.Diagnostics.HasError() {
		t.Fatalf("ImportState failed: %v", resp.Diagnostics.Errors())
	}

	var got svdemo.DemoWidgetAttachmentResourceModel
	if diags := resp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	if got.GadgetId.ValueString() != demoWidgetAttachmentTestGadgetId || got.WidgetId.ValueString() != demoWidgetAttachmentTestWidgetId {
		t.Errorf("segments = %q / %q, want %q / %q", got.GadgetId.ValueString(), got.WidgetId.ValueString(), demoWidgetAttachmentTestGadgetId, demoWidgetAttachmentTestWidgetId)
	}
}

// TestDemoWidgetAttachmentImportStateInvalidId verifies a malformed id is
// rejected instead of producing a half-filled state.
func TestDemoWidgetAttachmentImportStateInvalidId(t *testing.T) {
	ctx := newDemoWidgetAttachmentTestContext(t)

	importer, ok := ctx.resource.(resource.ResourceWithImportState)
	if !ok {
		t.Fatal("resource does not implement resource.ResourceWithImportState")
	}

	resp := resource.ImportStateResponse{State: tfsdk.State{
		Schema: ctx.schema,
		Raw:    tftypes.NewValue(ctx.schema.Type().TerraformType(context.Background()), nil),
	}}
	importer.ImportState(context.Background(), resource.ImportStateRequest{ID: "only-one-segment"}, &resp)
	if !resp.Diagnostics.HasError() {
		t.Fatal("ImportState should reject an id without both segments")
	}
}
