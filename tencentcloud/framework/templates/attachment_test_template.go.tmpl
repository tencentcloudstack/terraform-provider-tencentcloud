const (
	demoWidgetAttachmentTestGadgetId    = "gadget-12345"
	demoWidgetAttachmentTestWidgetId    = "widget-12345"
	demoWidgetAttachmentTestId          = "gadget-12345#widget-12345"
	demoWidgetAttachmentTestBoundAt     = "2024-01-01T00:00:00Z"
	demoWidgetAttachmentTestBoundStatus = "Bound"
)

func demoWidgetAttachmentStr(v string) *string { return &v }

// demoWidgetAttachmentTestGadget builds the parent-level describe answer: a
// gadget carrying the binding of the widget under test.
func demoWidgetAttachmentTestGadget() *demov20230101.Gadget {
	return &demov20230101.Gadget{
		GadgetId: demoWidgetAttachmentStr(demoWidgetAttachmentTestGadgetId),
		WidgetBindings: []*demov20230101.WidgetBinding{{
			GadgetId:    demoWidgetAttachmentStr(demoWidgetAttachmentTestGadgetId),
			WidgetId:    demoWidgetAttachmentStr(demoWidgetAttachmentTestWidgetId),
			BoundAt:     demoWidgetAttachmentStr(demoWidgetAttachmentTestBoundAt),
			BoundStatus: demoWidgetAttachmentStr(demoWidgetAttachmentTestBoundStatus),
		}},
	}
}

// demoWidgetAttachmentTestModel builds the terraform model used for
// plan/state.
// TEMPLATE: every unset attribute carries an EXPLICIT TYPED null value — the
// raw zero value breaks tfsdk Plan/State reflection with "Value Conversion
// Error". One typed null per model field, none skipped.
func demoWidgetAttachmentTestModel() svdemo.DemoWidgetAttachmentResourceModel {
	return svdemo.DemoWidgetAttachmentResourceModel{
		Id:          types.StringValue(demoWidgetAttachmentTestId),
		GadgetId:    types.StringValue(demoWidgetAttachmentTestGadgetId),
		WidgetId:    types.StringValue(demoWidgetAttachmentTestWidgetId),
		BindMode:    types.StringNull(),
		BoundAt:     types.StringNull(),
		BoundStatus: types.StringNull(),
	}
}

// patchDemoWidgetAttachmentSdkClient stubs the versioned client accessor and
// returns the mock SDK client whose methods the test patches next.
func patchDemoWidgetAttachmentSdkClient(patches *gomonkey.Patches, client *connectivity.TencentCloudClient) *demov20230101.Client {
	demoClient := &demov20230101.Client{}
	patches.ApplyMethodReturn(client, "UseDemoV20230101Client", demoClient)

	return demoClient
}

// stubDemoWidgetAttachmentDescribe stubs the parent-level describe API with
// the given gadgets.
func stubDemoWidgetAttachmentDescribe(patches *gomonkey.Patches, demoClient *demov20230101.Client, gadgets []*demov20230101.Gadget) {
	patches.ApplyMethodFunc(demoClient, "DescribeGadgets", func(request *demov20230101.DescribeGadgetsRequest) (*demov20230101.DescribeGadgetsResponse, error) {
		return &demov20230101.DescribeGadgetsResponse{Response: &demov20230101.DescribeGadgetsResponseParams{
			GadgetSet: gadgets,
			RequestId: demoWidgetAttachmentStr("fake-request-id"),
		}}, nil
	})
}

// demoWidgetAttachmentTestContext wires the resource to a configured client.
type demoWidgetAttachmentTestContext struct {
	resource resource.Resource
	schema   schema.Schema
	client   *connectivity.TencentCloudClient
}

func newDemoWidgetAttachmentTestContext(t *testing.T) *demoWidgetAttachmentTestContext {
	t.Helper()

	client := &connectivity.TencentCloudClient{}

	res := svdemo.NewDemoWidgetAttachmentResource()
	configured, ok := res.(resource.ResourceWithConfigure)
	if !ok {
		t.Fatalf("resource does not implement resource.ResourceWithConfigure")
	}

	var configureResp resource.ConfigureResponse
	configured.Configure(
		context.Background(),
		resource.ConfigureRequest{ProviderData: &sharedmeta.ProviderMeta{Client: client}},
		&configureResp,
	)
	if configureResp.Diagnostics.HasError() {
		t.Fatalf("failed to configure resource: %v", configureResp.Diagnostics.Errors())
	}

	var schemaResp resource.SchemaResponse
	res.Schema(context.Background(), resource.SchemaRequest{}, &schemaResp)
	if schemaResp.Diagnostics.HasError() {
		t.Fatalf("failed to build schema: %v", schemaResp.Diagnostics.Errors())
	}

	return &demoWidgetAttachmentTestContext{resource: res, schema: schemaResp.Schema, client: client}
}

func (c *demoWidgetAttachmentTestContext) plan(t *testing.T, m svdemo.DemoWidgetAttachmentResourceModel) tfsdk.Plan {
	t.Helper()

	plan := tfsdk.Plan{Schema: c.schema}
	if diags := plan.Set(context.Background(), m); diags.HasError() {
