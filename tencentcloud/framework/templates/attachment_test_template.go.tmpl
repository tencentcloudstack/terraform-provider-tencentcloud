}

// TestDemoWidgetAttachmentReadSuccess verifies Read splits the composite id
// into the parent query and picks the binding out of the parent describe.
func TestDemoWidgetAttachmentReadSuccess(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetAttachmentTestContext(t)
	demoClient := patchDemoWidgetAttachmentSdkClient(patches, ctx.client)

	var gotGadgetId string
	patches.ApplyMethodFunc(demoClient, "DescribeGadgets", func(request *demov20230101.DescribeGadgetsRequest) (*demov20230101.DescribeGadgetsResponse, error) {
		if len(request.GadgetIds) != 1 || request.GadgetIds[0] == nil {
			t.Errorf("expected the parent id filter to be passed")
		} else {
			gotGadgetId = *request.GadgetIds[0]
		}

		return &demov20230101.DescribeGadgetsResponse{Response: &demov20230101.DescribeGadgetsResponseParams{
			GadgetSet: []*demov20230101.Gadget{demoWidgetAttachmentTestGadget()},
			RequestId: demoWidgetAttachmentStr("fake-request-id"),
		}}, nil
	})

	var readResp resource.ReadResponse
	readResp.State = ctx.state(t, demoWidgetAttachmentTestModel())
	ctx.resource.Read(context.Background(), resource.ReadRequest{State: ctx.state(t, demoWidgetAttachmentTestModel())}, &readResp)
	if readResp.Diagnostics.HasError() {
		t.Fatalf("Read failed: %v", readResp.Diagnostics.Errors())
	}

	if gotGadgetId != demoWidgetAttachmentTestGadgetId {
		t.Errorf("DescribeGadgets called with %q, want the parent %q", gotGadgetId, demoWidgetAttachmentTestGadgetId)
	}

	var got svdemo.DemoWidgetAttachmentResourceModel
	if diags := readResp.State.Get(context.Background(), &got); diags.HasError() {
		t.Fatalf("failed to read back state: %v", diags.Errors())
	}
	if got.BoundAt.ValueString() != demoWidgetAttachmentTestBoundAt {
		t.Errorf("bound_at = %q, want %q", got.BoundAt.ValueString(), demoWidgetAttachmentTestBoundAt)
	}
}

// TestDemoWidgetAttachmentReadNotFound verifies that a parent describe
// without the binding drops the resource from state.
func TestDemoWidgetAttachmentReadNotFound(t *testing.T) {
	patches := gomonkey.NewPatches()
	defer patches.Reset()

	ctx := newDemoWidgetAttachmentTestContext(t)
	demoClient := patchDemoWidgetAttachmentSdkClient(patches, ctx.client)
	stubDemoWidgetAttachmentDescribe(patches, demoClient, []*demov20230101.Gadget{{
		GadgetId: demoWidgetAttachmentStr(demoWidgetAttachmentTestGadgetId),
	}})

	var readResp resource.ReadResponse
	readResp.State = ctx.state(t, demoWidgetAttachmentTestModel())
	ctx.resource.Read(context.Background(), resource.ReadRequest{State: ctx.state(t, demoWidgetAttachmentTestModel())}, &readResp)
	if readResp.Diagnostics.HasError() {
		t.Fatalf("Read should not error on a binding that is gone: %v", readResp.Diagnostics.Errors())
	}
	if !readResp.State.Raw.IsNull() {
		t.Error("state should be removed after the binding is confirmed gone")
	}
}

