// Open is invoked once per plan/apply. It reads the ephemeral value from the
// cloud API and writes it back to resp.Result.
func (e *DemoTempCredentialEphemeralResource) Open(ctx context.Context, req ephemeral.OpenRequest, resp *ephemeral.OpenResponse) {
	var data DemoTempCredentialEphemeralResourceModel
	resp.Diagnostics.Append(req.Config.Get(ctx, &data)...)
	if resp.Diagnostics.HasError() {
		return
	}

	widgetId := data.WidgetId.ValueString()
	if widgetId == "" {
		resp.Diagnostics.AddError("Missing widget_id", "widget_id is required and cannot be empty.")
		return
	}

	// TEMPLATE: read — build the request HERE (lookup id -> request), call
	// the service with (ctx, request); the returned values MUST be set into
	// the result model below. Requests are ALWAYS named after their API.
	describeTempCredentialRequest := demov20230101.NewDescribeTempCredentialRequest()
	describeTempCredentialRequest.WidgetId = fwHelper.String(widgetId)
	// TEMPLATE: every schema input must reach the request — an attribute the
	// schema accepts but the code silently drops is a logic bug.
	if !data.Duration.IsNull() && !data.Duration.IsUnknown() {
		describeTempCredentialRequest.Duration = data.Duration.ValueInt64Pointer()
	}

	service := NewDemoService(e.Client())

	token, expiredAt, err := service.DescribeTempCredential(ctx, describeTempCredentialRequest)
	if err != nil {
		resp.Diagnostics.AddError(
			"Error reading Demo temp credential",
			fmt.Sprintf("Could not read temp credential for widget %q: %v", widgetId, err),
		)

		return
	}

	data.SecretToken = types.StringValue(token)
	data.ExpiredAt = types.StringValue(expiredAt)

	resp.Diagnostics.Append(resp.Result.Set(ctx, &data)...)
}

